# ============================================================================
# !!! THIS IS A TEMPLATE — DO NOT EDIT THIS FILE DIRECTLY !!!
#
# Copy it first, then edit the copy:
#   cp configs/env.sh.example configs/env.sh
#
# configs/env.sh is machine-specific and gitignored. Each user maintains
# their own. Changes to configs/env.sh.example belong to the PROJECT, not
# to your local setup.
# ============================================================================
#
# The scripts source configs/env.sh automatically on startup.
# Uncomment the section below that matches your environment.
# ============================================================================

# ============================================================================
# Case 1: Native Linux (Ubuntu/Debian/CentOS/...) with VirtualBox or libvirt
# ============================================================================
# Nothing to configure. Vagrant and the hypervisor CLI (VBoxManage / virsh)
# are on PATH after normal apt/dnf installation. You can skip creating env.sh
# entirely, or leave it empty.

# ============================================================================
# Case 2: macOS with VMware Fusion or VirtualBox
# ============================================================================
# Nothing to configure. VMware's vmrun and VirtualBox's VBoxManage are on PATH
# after normal installation.

# ============================================================================
# Case 3: WSL (Windows) calling a Windows-installed hypervisor
# ============================================================================
# Vagrant runs inside WSL but talks to VirtualBox/VMware installed on Windows.
# Uncomment the lines matching your setup.

# export VAGRANT_WSL_ENABLE_WINDOWS_ACCESS="1"

# --- If using VirtualBox (Windows default path) ---
# export PATH="$PATH:/mnt/c/Program Files/Oracle/VirtualBox"

# --- If using VMware Workstation (Windows default path) ---
# export PATH="$PATH:/mnt/c/Program Files (x86)/VMware/VMware Workstation"

# --- If VMware is installed to a custom path, e.g. D drive ---
# export PATH="$PATH:/mnt/d/vmware"

# ============================================================================
# Optional: HTTP proxy (any OS)
# ============================================================================
# Set if your network requires a proxy to reach external hosts.

# export HTTPS_PROXY="http://127.0.0.1:7890"
# export HTTP_PROXY="http://127.0.0.1:7890"
